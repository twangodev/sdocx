{
	"name": "sdocx-web",
	"version": "0.1.0",
	"private": true,
	"packageManager": "bun@1.4.0",
	"type": "module",
	"scripts": {
		"dev": "bun run build:wasm && vite dev",
		"build:wasm": "wasm-pack build ../crates/sdocx-wasm --target web --out-dir ../../web/static/wasm --out-name sdocx_wasm --no-typescript --no-pack",
		"build": "bun run build:wasm && bun run build:app",
		"build:app": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"icons": "bun scripts/generate-icons.ts",
		"deploy": "wrangler deploy"
	},
	"devDependencies": {
		"@lucide/svelte": "^0.575.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.10.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.1.10",
		"wrangler": "^4.127.1"
	},
	"dependencies": {
		"fflate": "^0.8.2",
		"pdfjs-dist": "4.10.38"
	}
}

+#[test]
+fn nine_point_investigative_native_stream() {
+    let cases: serde_json::Value = serde_json::from_str(include_str!("../../../../tools/montblanc/nine-point/expanded-streams.json")).unwrap();
+    for case in cases.as_object().unwrap().values() {
+    let number = |v: &serde_json::Value| v.as_f64().unwrap() as f32;
+    let points: Vec<[f32; 2]> = case["input"]["points"].as_array().unwrap().iter().map(|p| [number(&p[0]), number(&p[1])]).collect();
+    let pressure: Vec<f32> = case["input"]["pressure"].as_array().unwrap().iter().map(number).collect();
+    let actual = many_point(Input { points: &points, pressure: &pressure, pen_size: number(&case["input"]["pen_size"]) }).unwrap();
+    let expected = case["result"]["stream"].as_array().unwrap();
+    assert_eq!(actual.len(), expected.len());
+    for (i, (actual, expected)) in actual.iter().zip(expected).enumerate() {
+        let symbol = expected[0].as_str().unwrap();
+        let call = if symbol.contains("::AddStartPoint(") { RtCall::Start } else if symbol.contains("::AddEndPoint(") { RtCall::End } else if symbol.contains("::AddPoint(") { RtCall::Point } else { panic!("unexpected symbol {symbol}") };
+        assert_eq!(actual.call, call, "record {i}");
+        for (lane, word) in expected[1].as_array().unwrap().iter().enumerate() {
+            let s = word.as_str().unwrap();
+            let bits = u32::from_le_bytes(std::array::from_fn(|j| u8::from_str_radix(&s[j * 2..j * 2 + 2], 16).unwrap()));
+            assert_eq!(actual.lanes[lane].to_bits(), bits, "record {i} lane {lane}");
+        }
+    }

+fn pencil_test_form(document: &mut Document, frames: &[Vec<[u8; 4]>]) -> Result<Object, String> {
+    use std::fmt::Write as _;
+    use lopdf::dictionary;
+    const LIMIT: usize = 128 * 1024 * 1024;
+    if frames.len() != 84 || frames.iter().any(|f| f.len() != 192*192) { return Err("pencil test frame bounds".into()); }
+    let mut states = Dictionary::new();
+    for a in 1..=255 { let id = document.add_object(dictionary!{"Type"=>"ExtGState", "ca"=>Object::Real(a as f32/255.)}); states.set(format!("A{a}"), id); }
+    let mut commands = String::from("0 0 0 rg 0 0 1 1 re f\n1 1 1 rg\n0.005208333333333333 0 0 0.005208333333333333 0 0 cm\n");
+    for frame in frames { for (i, px) in frame.iter().enumerate() { if px[3] != 0 { if commands.len().checked_add(40).is_none_or(|v| v > LIMIT) { return Err("pencil stream budget".into()); } writeln!(commands, "/A{} gs {} {} 1 1 re f", px[3], i%192, 191-i/192).unwrap(); } } }
+    let mask = document.add_object(Stream::new(dictionary!{"Type"=>"XObject", "Subtype"=>"Form", "BBox"=>vec![0.into(),0.into(),1.into(),1.into()], "Group"=>dictionary!{"S"=>"Transparency", "CS"=>"DeviceRGB", "I"=>true}, "Resources"=>dictionary!{"ExtGState"=>states}}, commands.into_bytes()));
+    let gs = document.add_object(dictionary!{"Type"=>"ExtGState", "SMask"=>dictionary!{"S"=>"Luminosity", "G"=>mask}});
+    Ok(Object::Stream(Stream::new(dictionary!{"Type"=>"XObject", "Subtype"=>"Form", "BBox"=>vec![0.into(),0.into(),1.into(),1.into()], "Group"=>dictionary!{"S"=>"Transparency", "CS"=>"DeviceRGB", "I"=>true}, "Resources"=>dictionary!{"ExtGState"=>dictionary!{"P"=>gs}}}, b"/P gs 0 0 0 rg 0 0 1 1 re f\n".to_vec())))
+}

+pub fn pencil_test_frames(stroke: &Stroke, scale: f32) -> Option<Vec<Vec<[u8; 4]>>> {
+    if ![1.,2.].contains(&scale) || stroke.rendering.as_ref()?.style.color_argb != Some(0xff000000) { return None; }
+    let mut source = stroke.clone();
+    for point in &mut source.points { point.y = 192. - point.y; }
+    let records = ink::pencil2::source::prepare_stroke(&source, 1.).ok()?;
+    use sha2::{Digest, Sha256};
+    let bytes: Vec<u8> = records.iter().flat_map(|r| r.lanes.iter().flat_map(|v| v.to_le_bytes())).collect();
+    if format!("{:x}", Sha256::digest(&bytes)) != "770651fc1b27bfa8a73731f1a3e24cf1a37847e920581aa36855c5107835c2fe" { return None; }
+    let count = records.len();
+    const PIXELS: usize = 192 * 192;
+    if count > 84 || count.checked_mul(PIXELS)?.checked_mul(4)? > 16 * 1024 * 1024 || count.checked_mul(PIXELS)?.checked_mul(256)? > 800 * 1024 * 1024 { return None; }
+    let ctx = ink::pencil2::device_raster::Context { scale, ..Default::default() };
+    records.iter().map(|r| ink::pencil2::device_raster::prepare(&[r.lanes],ctx).ok()?.render(None)).collect()
+}

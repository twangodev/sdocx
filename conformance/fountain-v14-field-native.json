  "shader_sources": {
    "vertex": "#version 300 es \n precision highp float; layout(location = 0) in vec2 aRectPoint; layout(location = 1) in vec2 aCalcurateData; layout(location = 2) in vec4 aPointInfo; layout(location = 3) in vec2 aDirection; layout(location = 4) in float transparency; layout(location = 5) in vec2 AAInfo; uniform mat4 ProjectionMatrix; out vec2 fragCoord; out float inputAlpha; out float innerRadius; out float alphaByWidth; void main(void) { vec2 normal; normal.x = aDirection.y; normal.y = -aDirection.x; vec2 position = aPointInfo.xy + aCalcurateData.x * (aDirection + normal * aCalcurateData.y) * aPointInfo.zw; gl_Position = ProjectionMatrix * vec4(position, 0.0, 1.0); fragCoord = vec2(aRectPoint.x, aRectPoint.y); inputAlpha = transparency; innerRadius = AAInfo.x; alphaByWidth = AAInfo.y; }",
    "fragment": "#version 300 es \n precision mediump float; uniform vec4 inputColor; in vec2 fragCoord; in float inputAlpha; in float innerRadius; in float alphaByWidth; vec2 center = vec2(0.5, 0.5); const float radius = 0.5; const float gradLength = 0.25; const float alphaRange = 0.93; out vec4 FragColor; void main(void) { float distY = abs(center.y - fragCoord.y); float gradAlpha = clamp(1.0 - alphaRange / gradLength * (gradLength - (radius - distY)), 0.0, 1.0); float dist = distance(center, fragCoord); float alpha = alphaByWidth; if (dist > innerRadius) { alpha *= (1.0 - (dist - innerRadius) / (0.5 - innerRadius)); } float pointAlpha = inputAlpha * gradAlpha * alpha; FragColor = vec4(inputColor.rgb, 1.0) * pointAlpha; }"
  },
